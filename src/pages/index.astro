---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventHero from '../components/EventHero.astro';
import RegistrationForm from '../components/RegistrationForm.astro';
---

<BaseLayout title="Atyang Gig | Event Registration">
  <main class="mx-auto flex min-h-screen w-full max-w-6xl items-center px-4 py-10 md:px-8">
    <div class="grid w-full gap-8 lg:grid-cols-[1.2fr_1fr]">
      <EventHero />
      <RegistrationForm />
    </div>
  </main>
</BaseLayout>
