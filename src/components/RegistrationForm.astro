<form id="registration-form" class="rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-xl">
  <h2 class="text-2xl font-bold text-white">Reserve your seat</h2>
  <p class="mt-2 text-sm text-slate-300">Enter your details and pay the KES 500 registration fee via M-PESA.</p>

  <div class="mt-5 space-y-4">
    <label class="block text-sm">
      <span class="mb-1 block font-medium">Full Name</span>
      <input
        required
        type="text"
        name="name"
        class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 outline-none ring-emerald-400 focus:ring"
        placeholder="John Doe"
      />
    </label>

    <label class="block text-sm">
      <span class="mb-1 block font-medium">Email Address</span>
      <input
        required
        type="email"
        name="email"
        class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 outline-none ring-emerald-400 focus:ring"
        placeholder="you@example.com"
      />
    </label>

    <label class="block text-sm">
      <span class="mb-1 block font-medium">M-PESA payment number</span>
      <input
        required
        type="tel"
        name="phone"
        pattern="^(07\\d{8}|2547\\d{8}|01\\d{8}|2541\\d{8})$"
        class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 outline-none ring-emerald-400 focus:ring"
        placeholder="07XXXXXXXX or 2547XXXXXXXX"
      />
    </label>
  </div>

  <p id="status-message" class="mt-4 min-h-6 text-sm text-emerald-300" aria-live="polite"></p>

  <button
    id="submit-button"
    type="submit"
    class="mt-4 w-full rounded-lg bg-emerald-500 px-4 py-3 font-semibold text-slate-950 transition hover:bg-emerald-400 disabled:cursor-not-allowed disabled:opacity-60"
  >
    Pay KES 500 & Register
  </button>
</form>

<script is:inline>
  const form = document.getElementById('registration-form');
  const submitButton = document.getElementById('submit-button');
  const statusMessage = document.getElementById('status-message');

  if (new URLSearchParams(window.location.search).get('verified') === '1' && statusMessage instanceof HTMLElement) {
    statusMessage.textContent = 'Email verified. Submit the form again to start your M-PESA payment.';
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!(form instanceof HTMLFormElement) || !(submitButton instanceof HTMLButtonElement) || !(statusMessage instanceof HTMLElement)) {
      return;
    }

    const formData = new FormData(form);
    const payload = {
      name: String(formData.get('name') || ''),
      email: String(formData.get('email') || ''),
      phone: String(formData.get('phone') || ''),
      amount: 500
    };

    submitButton.disabled = true;
    statusMessage.textContent = 'Checking your registration...';

    try {
      const response = await fetch('/api/stkpush', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
      });

      const responseText = await response.text();
      let result = {};

      if (responseText) {
        try {
          result = JSON.parse(responseText);
        } catch {
          throw new Error('The payment service returned an invalid response. Please try again.');
        }
      }

      if (result?.emailVerificationRequired) {
        statusMessage.textContent = result?.message || result?.error || 'Check your email to verify your registration before paying.';
        submitButton.textContent = 'I Have Verified My Email';
        return;
      }

      if (!response.ok) {
        throw new Error(result?.error || 'Unable to initiate M-PESA STK Push.');
      }

      if (result?.ResponseCode !== '0' && result?.ResponseCode !== 0) {
        throw new Error(result?.CustomerMessage || 'M-PESA did not accept the payment request.');
      }

      const checkoutRequestId = result?.CheckoutRequestID;

      if (!checkoutRequestId) {
        throw new Error('M-PESA did not return a checkout request ID.');
      }

      statusMessage.textContent = 'Prompt sent. Enter your PIN on your phone to complete payment.';

      const maxAttempts = 40;
      let paymentStatus = 'pending';

      for (let attempt = 0; attempt < maxAttempts; attempt += 1) {
        await new Promise((resolve) => window.setTimeout(resolve, 3000));

        const statusResponse = await fetch(
          `/api/payment-status?checkoutRequestId=${encodeURIComponent(checkoutRequestId)}`
        );
        const statusResult = await statusResponse.json();

        if (!statusResponse.ok) {
          throw new Error(statusResult?.error || 'Unable to check payment status.');
        }

        paymentStatus = statusResult?.status || 'pending';

        if (paymentStatus === 'paid') {
          statusMessage.textContent = 'Payment received. Your registration is confirmed.';
          submitButton.textContent = 'Pay KES 500 & Register';
          form.reset();
          break;
        }

        if (paymentStatus === 'failed') {
          throw new Error(statusResult?.message || 'Payment was cancelled or declined.');
        }

        statusMessage.textContent = 'Waiting for M-PESA confirmation...';
      }

      if (paymentStatus === 'pending') {
        throw new Error('Payment confirmation timed out. Check your M-PESA messages and try again.');
      }
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Something went wrong. Please try again.';
      statusMessage.textContent = message;
      submitButton.textContent = 'Try Again';
    } finally {
      submitButton.disabled = false;
    }
  });
</script>
